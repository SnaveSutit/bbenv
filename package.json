{
	"name": "envbench",
	"description": "Envbench allows the creation and management of multiple unique Blockbench environments.",
	"version": "4.0.0",
	"author": {
		"name": "Titus Evans (SnaveSutit)",
		"email": "snavesutit@gmail.com",
		"url": "https://discordapp.com/users/213746232923783168"
	},
	"repository": {
		"type": "github",
		"url": "https://github.com/SnaveSutit/envbench"
	},
	"type": "commonjs",
	"bin": {
		"envbench": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./cli": "./dist/cli.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"bundle": "bun run ./.scripts/build.ts",
		"dev": "node-modules-vscode-problems-patch && bun run ./.scripts/build.ts --dev",
		"build": "bun run bundle && tsc -p tsconfig.build.json",
		"envbench": "bun ./dist/cli.js",
		"test": "bun test src/core",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^22.5.5",
		"@types/terminal-kit": "^2.5.6",
		"eslint": "^9.20.0",
		"jiti": "^2.4.2",
		"node-modules-vscode-problems-patch": "^1.0.9",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.23.0"
	},
	"dependencies": {
		"chalk": "^5.4.1",
		"commander": "^13.1.0",
		"compare-versions": "^6.1.1",
		"strip-ansi": "^7.1.0",
		"terminal-kit": "^3.1.1",
		"wrap-ansi": "^9.0.0",
		"yaml": "^2.8.2"
	}
}
